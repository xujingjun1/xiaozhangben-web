# ============ 可选环境变量示例 ============
# 用法：复制为 api/.env（或项目根目录 .env，两处都会被加载）
# 已存在的系统环境变量优先，不会被文件覆盖。
# 全部为可选：不配置只影响对应功能，核心记账功能不受影响。

# 服务端口（默认 8080）
PORT=8080

# 百度 OCR 密钥 —— 拍照识别账单用；不配置则该功能不可用
# 申请地址：https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
BAIDU_OCR_API_KEY=你的APIKey
BAIDU_OCR_SECRET_KEY=你的SecretKey

# 管理员用户ID白名单（逗号分隔），拥有 /api/feedbacks/all 全站反馈查看权限
ADMIN_USER_IDS=你的用户ID

# 也可以不用环境变量：在 data/admin.json 中放 ["用户ID"] 或 ["ID1","ID2"]，
# 服务启动时读取；同时存在时环境变量优先。

# 注意：前端接口地址在 .env.production 配置（VITE_API_URL=/api，同源相对路径），
# 不要写在本文件 —— Vite 只读取带 VITE_ 前缀的变量。
