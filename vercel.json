{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": false,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/app-latest\\.apk",
      "dest": "/app-latest.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"xiaozhangben.apk\""
      }
    },
    {
      "src": "^/app(?:\\/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^\\/$",
      "dest": "/landing.html"
    },
    {
      "src": "/(.*)",
      "dest": "/landing.html"
    }
  ]
}
