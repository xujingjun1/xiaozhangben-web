# 腾讯云 API 密钥
TENCENT_SECRET_ID=你的SecretId
TENCENT_SECRET_KEY=你的SecretKey

# 腾讯云短信配置
SMS_APP_ID=你的SmsSdkAppId
SMS_SIGN_NAME=你的签名
SMS_TEMPLATE_ID=你的模板ID

# 管理员用户ID白名单（逗号分隔），拥有 /api/feedbacks/all 全站反馈查看权限
ADMIN_USER_IDS=你的用户ID

# 也可以不用环境变量：在 api/data/admin.json（或部署目录 data/admin.json）中放
# ["你的用户ID"] 或 "你的用户ID1,你的用户ID2"，服务启动时读取，环境变量优先。
